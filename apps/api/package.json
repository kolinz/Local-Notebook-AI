{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Local Notebook AI - NestJS backend (API / business logic layer; the only layer allowed to talk to Ollama).",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "echo \"[api] no tests yet\"",
    "db:generate": "node scripts/db-env.js drizzle-kit generate",
    "db:migrate": "node scripts/db-env.js drizzle-kit migrate",
    "db:seed": "node scripts/db-env.js tsx src/db/seed.ts"
  },
  "dependencies": {
    "@local-notebook-ai/storage": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.0.0",
    "mammoth": "^1.12.2",
    "multer": "1.4.4-lts.1",
    "pdfjs-dist": "^6.3.289",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5"
  }
}
