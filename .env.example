# ------------------------------------------------------------
# Local Notebook AI - .env.example
#
# Phase 1.5: environment-based configuration management.
#
# Copy this file to `.env` at the repository root and adjust values as
# needed:
#
#   cp .env.example .env
#
# apps/api loads and validates this file at startup (see
# apps/api/src/config). apps/api will refuse to start and print a clear
# error listing every missing/invalid variable if required values are
# absent.
#
# apps/web only ever reads a small, explicitly allow-listed subset of
# these values (APP_BASE_URL, API_BASE_URL, DEFAULT_LOCALE,
# SUPPORTED_LOCALES) via apps/web/src/config/public-env.ts. Secrets such
# as SESSION_SECRET, DATABASE_URL, and INITIAL_ADMIN_PASSWORD are never
# read by apps/web and never reach the browser.
# ------------------------------------------------------------

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
PORT_WEB=3000
PORT_API=4000

# ------------------------------------------------------------
# Database
# apps/api uses Prisma + SQLite from Phase 2 onward. A relative "file:"
# path here is resolved relative to the repository root (not to
# apps/api/prisma/) by both the running app and `pnpm db:migrate` /
# `pnpm db:seed`, so the same data/ directory is always used.
# ------------------------------------------------------------
DATABASE_URL=file:./data/local-notebook-ai.sqlite

# ------------------------------------------------------------
# Session / Cookie
# SESSION_SECRET is required and must be at least 16 characters. It is
# read only by apps/api and is never exposed to apps/web or the browser.
# ------------------------------------------------------------
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_COOKIE_NAME=lna_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------
# CSRF
# ------------------------------------------------------------
CSRF_COOKIE_NAME=lna_csrf
CSRF_HEADER_NAME=x-csrf-token

# ------------------------------------------------------------
# Ollama
# (Not wired up to an actual Ollama connection until Phase 9.)
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_GENERATION_MODEL=phi4-mini:3.8b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text:latest
# Temperature passed to Ollama for RAG answer generation, HyDE
# hypothetical-document generation, and file summarization (not used
# for embeddings, which have no temperature concept). Lower = more
# deterministic. Ollama's own default (~0.8) is tuned for open-ended
# chat and can make a small local model inconsistently add unrequested
# preamble before a required fixed-wording answer. Raise this if a
# given model's answers feel too rigid/repetitive.
OLLAMA_GENERATION_TEMPERATURE=0.2
# Runaway-generation guards (Ollama's `num_predict`, i.e. max output
# tokens). Kept separate because HyDE's hypothetical document is meant
# to be short (~300-600 characters per its own prompt), while RAG
# answers and file summaries are ordinary prose that can run longer.
# These exist to stop a runaway/looping generation (observed with a
# "thinking"-style model emitting its internal reasoning instead of the
# requested short document), not to limit normal answer length.
OLLAMA_HYDE_MAX_OUTPUT_TOKENS=400
OLLAMA_ANSWER_MAX_OUTPUT_TOKENS=1024
# Disables "thinking" mode for models that support it (Ollama's
# top-level `think: false`). Without this, some reasoning-capable
# models (observed with a Granite reasoning variant; Qwen3 and others
# have similar modes) return their internal reasoning text as the
# response when called via the plain completion endpoint, instead of
# the requested short output. Ignored by models/Ollama versions without
# a thinking mode. Set to false to let thinking output through.
OLLAMA_DISABLE_THINKING=true

# ------------------------------------------------------------
# Storage
# (Not wired up to an actual StorageAdapter implementation until Phase 7.)
# ------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------
# i18n
# apps/web reads DEFAULT_LOCALE / SUPPORTED_LOCALES directly (public,
# non-secret values). Actual locale switching UI lands in Phase 5.
# ------------------------------------------------------------
DEFAULT_LOCALE=ja
SUPPORTED_LOCALES=ja,en

# ------------------------------------------------------------
# RAG
# (Not wired up to Standard/HyDE RAG execution until Phase 11/12.)
# ------------------------------------------------------------
RAG_DEFAULT_STRATEGY=hyde
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.68
ALLOW_NOTEBOOK_RAG_OVERRIDE=true
SHOW_RETRIEVAL_DEBUG=true
# Phase 12: general users never see the HyDE hypothetical document's
# text when false (see RagController).
ALLOW_HYDE_DOCUMENT_PREVIEW=false

# ------------------------------------------------------------
# Initial Admin
# Required (email/password). Used by `pnpm db:seed` (Phase 2) to create
# the first administrator account if one does not already exist.
# INITIAL_ADMIN_PASSWORD must be at least 8 characters.
# Change these before any real deployment.
# ------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-on-first-login
INITIAL_ADMIN_LOCALE=ja
